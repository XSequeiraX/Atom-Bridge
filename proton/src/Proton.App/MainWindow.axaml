<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Proton.App.MainWindow"
        x:Name="Root"
        Title="Proton" Width="1240" Height="860" MinWidth="1000" MinHeight="640">
  <Window.Styles>
    <Style Selector="Border.step">
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="14" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BorderBrush" Value="#44808080" />
      <Setter Property="Background" Value="#14808080" />
    </Style>
    <Style Selector="TextBlock.h">
      <Setter Property="FontSize" Value="15" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="TextBlock.dim">
      <Setter Property="Opacity" Value="0.65" />
    </Style>
  </Window.Styles>

  <Grid RowDefinitions="Auto,*,Auto" Margin="18">
    <StackPanel Grid.Row="0" Spacing="2">
      <TextBlock Text="Proton" FontSize="28" FontWeight="SemiBold" />
      <TextBlock Classes="dim" Text="Copy the cards and match the files to the takes the Atom logged" />
    </StackPanel>

    <Grid Grid.Row="1" ColumnDefinitions="520,14,*" Margin="0,12,0,8">

      <ScrollViewer Grid.Column="0">
        <StackPanel Spacing="12" Margin="0,0,10,0">

          <Border Classes="step">
            <StackPanel Spacing="8">
              <TextBlock Classes="h" Text="1  Takes from the Atom" />
              <TextBox x:Name="AddressBox" Watermark="http://atom:8080 (Tailscale), or a .json / .csv file" />
              <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                <TextBox x:Name="DayBox" Grid.Column="0" Watermark="only this day (YYYY-MM-DD), optional" />
                <Button x:Name="LoadButton" Grid.Column="1" Content="Load" Click="OnLoad" />
                <Button Grid.Column="2" Content="Open file..." Click="OnOpenFile" />
              </Grid>
              <StackPanel Orientation="Horizontal" Spacing="10">
                <Button Content="Find on the USB stick" Click="OnFindUsb" />
                <TextBlock x:Name="TakesInfo" VerticalAlignment="Center" Classes="dim" Text="No takes loaded" />
              </StackPanel>
            </StackPanel>
          </Border>

          <Border Classes="step">
            <StackPanel Spacing="8">
              <TextBlock Classes="h" Text="2  Cards" />
              <TextBlock Classes="dim" Text="Add each card or folder and say which camera it is from." TextWrapping="Wrap" />
              <ItemsControl ItemsSource="{Binding #Root.Cards}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <StackPanel Spacing="4" Margin="0,4">
                      <TextBlock Text="{Binding Path}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Path}" />
                      <Grid ColumnDefinitions="200,*,Auto" ColumnSpacing="8">
                        <ComboBox Grid.Column="0" HorizontalAlignment="Stretch" PlaceholderText="Which camera?"
                                  ItemsSource="{Binding #Root.CameraNames}" SelectedItem="{Binding Camera, Mode=TwoWay}" />
                        <TextBlock Grid.Column="1" Text="{Binding Info}" VerticalAlignment="Center" Classes="dim" TextTrimming="CharacterEllipsis" />
                        <Button Grid.Column="2" Content="Remove" Click="OnRemoveCard" />
                      </Grid>
                    </StackPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Content="Add card..." Click="OnAddCard" />
                <Button Content="Rescan" Click="OnRescan" />
              </StackPanel>
            </StackPanel>
          </Border>

          <Border Classes="step">
            <StackPanel Spacing="8">
              <TextBlock Classes="h" Text="3  Destination" />
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <TextBox x:Name="DestBox" Grid.Column="0" Watermark="Folder for the copies" />
                <Button Grid.Column="1" Content="Browse..." Click="OnBrowseDest" />
              </Grid>
              <TextBox x:Name="TemplateBox" />
              <TextBlock Classes="dim" TextWrapping="Wrap" Text="Folder pattern: {day} {session} {take} {take:00} {camera} {alias} {file} {stem} {ext}" />
              <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="Copy" VerticalAlignment="Center" Classes="dim" />
                <NumericUpDown x:Name="ParallelBox" Width="120" Minimum="1" Maximum="16" Value="4" FormatString="0" />
                <TextBlock Text="files at once" VerticalAlignment="Center" Classes="dim" />
              </StackPanel>
            </StackPanel>
          </Border>

        </StackPanel>
      </ScrollViewer>

      <Border Grid.Column="2" Classes="step">
        <Grid RowDefinitions="Auto,Auto,*" RowSpacing="8">
          <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
            <TextBlock Grid.Column="0" Classes="h" Text="4  Result" VerticalAlignment="Center" />
            <Button Grid.Column="1" x:Name="ReviewButton" Content="Review shoot log and matches..." Click="OnReview" IsEnabled="False" />
          </Grid>
          <TextBlock Grid.Row="1" x:Name="SummaryText" Text="Press Match to see which file belongs to which take." Classes="dim" TextWrapping="Wrap" />
          <ListBox Grid.Row="2" x:Name="ResultList">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <TextBlock Text="{Binding Text}" Foreground="{Binding Brush}" FontFamily="Menlo,Consolas,monospace" FontSize="12" />
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </Grid>
      </Border>

    </Grid>

    <StackPanel Grid.Row="2" Spacing="8">
      <ProgressBar x:Name="Bar" Minimum="0" Maximum="1" Value="0" Height="8" />
      <TextBlock x:Name="StatusText" Text="Ready" TextWrapping="Wrap" />
      <StackPanel Orientation="Horizontal" Spacing="8">
        <Button x:Name="MatchButton" Content="Match" Click="OnMatch" />
        <Button x:Name="CopyButton" Content="Copy" Click="OnCopy" Background="#FF2563EB" Foreground="White" />
        <Button x:Name="CancelButton" Content="Cancel" Click="OnCancel" IsEnabled="False" />
        <Button Content="Save Resolve CSV and report..." Click="OnSaveOutputs" />
      </StackPanel>
    </StackPanel>
  </Grid>
</Window>
